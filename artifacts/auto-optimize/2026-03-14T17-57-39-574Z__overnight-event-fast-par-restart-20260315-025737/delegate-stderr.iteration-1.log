"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
const fs = require('fs');
const vm = require('vm');

function makeContext(){
  let now = 0;
  function LGraph(){
    this.status = LGraph.STATUS_STOPPED;
    this.links = {};
    this._nodes = [];
  }
  LGraph.STATUS_STOPPED = 1;
  LGraph.STATUS_RUNNING = 2;
  LGraph.prototype.configure = function(payload){
    this.payload = payload || {};
    this.links = {};
    this._nodes = [];
  };
  LGraph.prototype.sendEventToAllNodes = function(){};

  const context = {
    console,
    setTimeout,
    clearTimeout,
    setInterval,
    clearInterval,
    Math,
    Date,
    JSON,
    navigator: {},
    importScripts: function(){},
    performance: { now: () => { const out = now; now += 50; return out; } },
    LiteGraph: { getTime: () => 0 },
    LGraph,
    App: {},
    __messages: []
  };
  context.self = context;
  context.window = context;
  context.globalThis = context;
  context.postMessage = (message) => context.__messages.push(message);
  context.App.EventFastEngine = function(graph, options){
    this.graph = graph;
    this.options = options || {};
    this.runtimeMode = 'compiled';
    this.updates = 0;
  };
  context.App.EventFastEngine.prototype.reset = function(){};
  context.App.EventFastEngine.prototype.stop = function(){};
  context.App.EventFastEngine.prototype.update = function(ms){
    this.updates += 1;
    if(typeof context.advanceSimTime === 'function') context.advanceSimTime(ms);
  };
  context.App.EventFastEngine.prototype.getDebugStats = function(){
    return { runtimeMode: this.runtimeMode, updates: this.updates };
  };
  return context;
}

async function invoke(context, type, payload){
  const id = context.__messages.length + 1;
  context.onmessage({ data: { id, type, payload } });
  await Promise.resolve();
  await new Promise((resolve) => setImmediate(resolve));
  const message = context.__messages[context.__messages.length - 1];
  if("'!message) throw new Error(`No response for ${type}`);
  if(message.ok === false) throw new Error(message.error || `Request failed for ${type}`);
  return message.payload;
}

async function verifyWorker(file, initPayload){
  const context = makeContext();
  const source = fs.readFileSync(file, '"'utf8');
  vm.runInNewContext(source, context, { filename: file });
  await invoke(context, 'init', initPayload);
  const zero = await invoke(context, 'runBenchmarkCase', Object.assign({}, initPayload, { wallMs: 0, realStepMs: 16 }));
  const def = await invoke(context, 'runBenchmarkCase', Object.assign({}, initPayload, { realStepMs: 16 }));
  if(zero.loops "'!== 0){
    throw new Error(`${file} expected zero loops for wallMs=0, got ${zero.loops}`);
  }
  if(def.loops <= 0){
    throw new Error(`${file} expected default benchmark loops to remain positive, got ${def.loops}`);
  }
  return { file, zeroLoops: zero.loops, defaultLoops: def.loops };
}

(async () => {
  const base = process.cwd();
  const results = [];
  results.push(await verifyWorker(
    `${base}'"\\\\js\\\\app\\\\engine-fast-worker.js"'`,
    { graphData: { nodes: [], links: [] }, engineOptions: {}, seed: 1 }
  ));
  results.push(await verifyWorker(
    `${base}'"\\\\js\\\\app\\\\engine-fast-par-worker.js"'`,
    {
      graphData: { nodes: [], links: [] },
      partition: { partitionId: 0, nodeIds: [], outgoingCutEdges: [], ownedSinkIds: [] },
      engineOptions: {},
      seed: 1
    }
  ));
  console.log(JSON.stringify({ ok: true, results }, null, 2));
})().catch((error) => {
  console.error(error && error.stack ? error.stack : String(error));
  process.exit(1);
});
