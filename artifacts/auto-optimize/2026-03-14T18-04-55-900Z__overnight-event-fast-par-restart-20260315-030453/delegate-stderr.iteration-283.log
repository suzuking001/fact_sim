  if ("'!match) throw new Error(`Missing patched wallMs logic in ${file}`);
  const argName = match[1];
  const expr = `${match[0]}; return wallMs;`;
  const fn = new Function(argName, expr);
  const zero = fn({ wallMs: 0 });
  const absent = fn({});
  const negative = fn({ wallMs: -5 });
  if (zero !== 0) throw new Error(`${file}: expected wallMs=0 to stay 0, got ${zero}`);
  if (absent !== 2000) throw new Error(`${file}: expected missing wallMs to default to 2000, got ${absent}`);
  if (negative !== 0) throw new Error(`${file}: expected negative wallMs to clamp to 0, got ${negative}`);
  console.log(JSON.stringify({ file, zero, absent, negative }));
}
