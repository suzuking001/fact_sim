function load(rel){
  const file = base + '\\\\' + rel.replace(/\\//g, '\\\\');
  const code = fs.readFileSync(file, 'utf8');
  vm.runInContext(code, context, { filename: file });
}
const context = vm.createContext({
  console,
  Set,
  Map,
