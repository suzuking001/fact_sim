  navigator: { hardwareConcurrency: 8 },
  Worker: function Worker(){},
});
context.window = context;
context.globalThis = context;
context.self = context;
context.App = {
  compactGraphData(data){ return JSON.parse(JSON.stringify(data)); },
  repairGraphLinks(){},
  stopGroups: {
    injectSerializedData(data){
      data.extra = data.extra || {};
      data.extra.stopGroupsV1 = { groups: [{ id: 1, nodeIds: [1, 2] }] };
    },
    restoreSerializedData(){}
  },
  compileFastGraph(graph){
    const nodes = Array.isArray(graph && graph._nodes) ? graph._nodes : [];
    return {
      nodeCount: nodes.length,
      edgeCount: 0,
      firstOutEdge: new Int32Array(nodes.length),
      outEdgeCount: new Int32Array(nodes.length),
      outTargets: new Int32Array(0),
      nodeIds: nodes.map((node) => Number(node.id)),
      meta: {
        sourceNodeIndices: [],
        sinkNodeIndices: [],
        indexByNodeId: Object.fromEntries(nodes.map((node, index) => [String(node.id), index]))
      }
    };
  },
  createFastCompatAdapter(){
    return {
      getFallbackProfile(){
        return { executableCount: 0, executableTypes: [] };
      }
    };
  },
  getSupportedSimModes(){ return ['dt', 'event', 'event-fast']; },
  normalizeSimMode(mode){ return String(mode || ''); },
  getSimModeLabel(mode){ return String(mode || ''); },
  getBenchmarkSimModes(){ return ['dt', 'event-fast-worker']; },
  getEngineTestModes(){ return ['dt', 'event-fast-worker']; },
  createSimEngine(){ return { runtimeMode: 'event-fast' }; },
  createHeadlessSimRunner(mode, graphData){
    return { mode, graphData, runtimeMode: "'`fallback-${mode}` };
  }
};
context.LGraph = function LGraph(){
  this._nodes = [];
  this.links = {};
};
context.LGraph.prototype.configure = function configure(data){
  const nodes = Array.isArray(data && data.nodes) ? data.nodes : [];
  this._nodes = nodes.map((node) => ({ id: Number(node.id) }));
  this.links = {};
};
context.configureGraphClock = function configureGraphClock(){};
load('"'js/app/engine-fast-par-partitioner.js');
load('js/app/engine-fast-par-host.js');
const fakeGraph = {
  serialize(){
    return {
      nodes: Array.from({ length: 8 }, (_, index) => ({ id: index + 1 })),
      links: [],
      extra: {}
    };
  }
};
const plan = context.App.createEventFastParPlan(fakeGraph, {});
assert.strictEqual(plan.canParallelize, false);
assert.strictEqual(plan.reason, 'stop-groups-present');
assert.ok(plan.graphData && plan.graphData.extra && plan.graphData.extra.stopGroupsV1);
const runner = context.App.createHeadlessSimRunner('event-fast-par', fakeGraph, {});
assert.strictEqual(runner.mode, 'event-fast-worker');
assert.ok(runner.graphData && runner.graphData.extra && runner.graphData.extra.stopGroupsV1);
console.log(JSON.stringify({ ok: true, reason: plan.reason, fallbackMode: runner.mode }));
