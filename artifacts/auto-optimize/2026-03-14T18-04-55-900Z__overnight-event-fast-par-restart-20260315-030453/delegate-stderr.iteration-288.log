const fs = require('fs');
const vm = require('vm');
const { performance } = require('perf_hooks');

function assert(condition, message){
  if("'!condition) throw new Error(message);
}

async function drain(){
  await new Promise((resolve)=> setImmediate(resolve));
  await new Promise((resolve)=> setImmediate(resolve));
}

async function verifyWorkerBenchmark(filePath, initPayload){
  const source = fs.readFileSync(filePath, '"'utf8');
  const posts = [];

  class StubGraph {
    constructor(){
      this.status = StubGraph.STATUS_STOPPED;
      this._nodes = [];
      this.links = {};
    }
    configure(data){
      this._data = data || { nodes: [], links: [] };
    }
    serialize(){
      return JSON.parse(JSON.stringify(this._data || { nodes: [], links: [] }));
    }
    sendEventToAllNodes(){}
  }
  StubGraph.STATUS_STOPPED = 1;
  StubGraph.STATUS_RUNNING = 2;

  const context = {
    performance,
    importScripts: ()=>{},
    LGraph: StubGraph,
    LiteGraph: { getTime: ()=> performance.now() },
    setTimeout,
    clearTimeout,
    console,
    JSON,
    Math,
    Number,
    String,
    Boolean,
    Object,
    Array,
    Map,
    Set,
    Uint8Array,
    Uint16Array,
    Uint32Array,
    Int16Array,
    Int32Array,
    Float32Array,
    Float64Array,
    postMessage: (message)=> posts.push(message),
    App: {
      repairGraphLinks(){},
      stopGroups: { restoreSerializedData(){} },
      createSimEngine(){ return null; },
      EventFastEngine: class {
        constructor(graph, options){
          this.graph = graph;
          this.options = options;
          this.runtimeMode = 'compiled';
        }
        reset(){}
        update(ms){ context.advanceSimTime(ms); }
        stop(){}
        getDebugStats(){ return { runtimeMode: this.runtimeMode }; }
      }
    }
  };
  context.self = context;
  context.window = context;
  context.globalThis = context;

  vm.createContext(context);
  vm.runInContext(source, context, { filename: filePath });

  context.onmessage({ data: { id: 1, type: 'init', payload: initPayload } });
  await drain();
  const initResponse = posts.pop();
  assert(initResponse && initResponse.ok, "'`${filePath}: init failed`);

  posts.length = 0;
  context.onmessage({ data: { id: 2, type: '"'runBenchmarkCase', payload: Object.assign({}, initPayload, { wallMs: 0, realStepMs: 16 }) } });
  await drain();
  const benchResponse = posts.pop();
  assert(benchResponse && benchResponse.ok, "'`${filePath}: benchmark failed`);
  const payload = benchResponse.payload || {};
  assert(payload.loops === 0, `${filePath}: expected 0 loops for wallMs=0, got ${payload.loops}`);
  assert(Number(payload.wallMs) >= 0 && Number(payload.wallMs) < 50, `${filePath}: expected near-zero wallMs, got ${payload.wallMs}`);
}

(async()=>{
  const workerPath = '"'js/app/engine-fast-worker.js';
  const parWorkerPath = 'js/app/engine-fast-par-worker.js';
  const workerHostPath = 'js/app/engine-fast-worker-host.js';
  const parHostPath = 'js/app/engine-fast-par-host.js';

  const workerHostSource = fs.readFileSync(workerHostPath, 'utf8');
  const parHostSource = fs.readFileSync(parHostPath, 'utf8');
  assert(workerHostSource.includes(\"engine-fast-worker.js?v=20260313b\"), 'worker host cache key was not updated');
  assert(parHostSource.includes(\"engine-fast-par-worker.js?v=20260315c\"), 'parallel host cache key was not updated');
  assert(parHostSource.includes('const rawWallMs = Number(options && options.wallMs);'), 'parallel host wallMs parsing patch missing');
