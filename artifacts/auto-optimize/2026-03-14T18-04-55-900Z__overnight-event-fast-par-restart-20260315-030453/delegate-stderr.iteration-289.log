const fs = require('fs');
const vm = require('vm');
const assert = require('assert');

global.window = global;
global.App = {};
global.Worker = function(){};
global.LGraph = function(){};
global.performance = global.performance || { now: () => 0 };
global.configureGraphClock = function(){};

const src = fs.readFileSync('js/app/engine-fast-par-host.js', 'utf8');
vm.runInThisContext(src, { filename: 'engine-fast-par-host.js' });

async function main(){
  const host = new App.EventFastParHost({}, {});
  host.resetAsync = async function(){ this._lastSimTimeMs = 0; return { stats: null }; };
  host._runner = null;
  host._independentPartitions = true;
  host._workers = [
    {
      runBenchmarkCaseAsync: async () => ({ simTimeMs: 100, wallMs: 11, loops: 9, stats: { updateCalls: 9 }, ownedSnapshot: { sinkMetrics: { sinkCount: 1, totalCompleted: 2, sinks: [] } } }),
      runUntilSimTimeAsync: async () => ({ simTimeMs: 100, wallMs: 11, loops: 9, stats: { updateCalls: 9 }, ownedSnapshot: { sinkMetrics: { sinkCount: 1, totalCompleted: 2, sinks: [] } } })
    },
    {
      runBenchmarkCaseAsync: async () => ({ simTimeMs: 100, wallMs: 12, loops: 7, stats: { updateCalls: 7 }, ownedSnapshot: { sinkMetrics: { sinkCount: 1, totalCompleted: 3, sinks: [] } } }),
      runUntilSimTimeAsync: async () => ({ simTimeMs: 100, wallMs: 12, loops: 7, stats: { updateCalls: 7 }, ownedSnapshot: { sinkMetrics: { sinkCount: 1, totalCompleted: 3, sinks: [] } } })
    }
  ];

  const benchmark = await host.runBenchmarkCaseAsync({});
  assert.strictEqual(benchmark.loops, 9, "'`expected max benchmark loops, got ${benchmark.loops}`);

  const until = await host.runUntilSimTimeAsync({});
  assert.strictEqual(until.loops, 9, `expected max runUntil loops, got ${until.loops}`);

  console.log(JSON.stringify({ ok: true, benchmarkLoops: benchmark.loops, untilLoops: until.loops }));
}

main().catch((err) => {
  console.error(err && err.stack || err);
  process.exit(1);
});
