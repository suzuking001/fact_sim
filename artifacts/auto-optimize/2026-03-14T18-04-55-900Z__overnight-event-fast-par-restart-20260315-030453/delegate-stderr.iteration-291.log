      createEventFastParPlan: () => ({ canParallelize: false, fallbackMode: 'event-fast-worker' })
    },
    LiteGraph: { getTime: () => 0 },
    LGraph: class {
      static STATUS_STOPPED = 1;
      static STATUS_RUNNING = 2;
      constructor(){
        this._nodes = [];
        this.links = {};
        this.status = 1;
      }
      configure(_data){
        this._nodes = [];
        this.links = {};
      }
      serialize(){
        return { nodes: [], links: [] };
      }
      sendEventToAllNodes(){}
      getNodeById(){ return null; }
    },
    Worker: class {
      constructor(){ }
      addEventListener(){}
      postMessage(){}
      terminate(){}
    }
  };
  context.window = context;
  context.self = context;
  context.globalThis = context;
  return vm.createContext(context);
}

function loadScript(relPath, extraSetup){
  const context = createBaseContext();
  context.importScripts = () => {};
  context.App.EventFastEngine = class {
    constructor(graph){
      this.graph = graph;
      this.runtimeMode = 'compiled';
    }
    reset(){}
    update(ms){
      if(typeof context.advanceSimTime === 'function') context.advanceSimTime(ms);
    }
    stop(){}
    getDebugStats(){ return { runtimeMode: this.runtimeMode }; }
  };
  if(typeof extraSetup === 'function') extraSetup(context);
  const src = fs.readFileSync(path.join(repo, relPath), 'utf8');
  vm.runInContext(src, context, { filename: relPath });
  return context;
}

async function verifyParHost(){
  const context = loadScript('js/app/engine-fast-par-host.js');
  const host = Object.create(context.App.EventFastParHost.prototype);
  host._runner = null;
  host._workers = [{}, {}];
  host._independentPartitions = false;
  host._lastSimTimeMs = 0;
  host._lastStats = { runtimeMode: 'parallel' };
  host.runtimeMode = 'parallel';
  host.resetAsync = async () => ({ runtimeMode: 'parallel', stats: host._lastStats });
  host._stepParallel = async () => {
    throw new Error('runBenchmarkCaseAsync stepped despite wallMs=0');
  };
  const result = await host.runBenchmarkCaseAsync({ wallMs: 0, realStepMs: 16 });
  assert(result.loops === 0, "'`parallel host loops=${result.loops}`);
}

function callWorker(context, type, payload){
  return new Promise((resolve, reject) => {
    const id = Math.floor(Math.random() * 1000000);
    const timer = setTimeout(() => reject(new Error(`${type} timed out`)), 1000);
    context.postMessage = (message) => {
      if(!message || message.id !== id) return;
      clearTimeout(timer);
      if(message.ok === false) reject(new Error(message.error || `${type} failed`));
      else resolve(message.payload);
    };
    context.onmessage({ data: { id, type, payload } });
  });
}

async function verifyWorker(relPath, initPayload){
  const context = loadScript(relPath);
  await callWorker(context, '"'init', initPayload);
  const result = await callWorker(context, 'runBenchmarkCase', { wallMs: 0, realStepMs: 16, seed: 1 });
  assert(result.loops === 0, "'`${relPath} loops=${result.loops}`);
}

(async () => {
  await verifyParHost();
  await verifyWorker('"'js/app/engine-fast-worker.js', { graphData: { nodes: [], links: [] }, engineOptions: {}, seed: 1 });
  await verifyWorker('js/app/engine-fast-par-worker.js', { graphData: { nodes: [], links: [] }, partition: { nodeIds: [], ownedSinkIds: [], outgoingCutEdges: [] }, engineOptions: {}, seed: 1 });
  console.log('verified: wallMs=0 benchmark paths return zero loops for par host, fast worker, and par worker');
})().catch((error) => {
  console.error(error && error.stack ? error.stack : error);
  process.exit(1);
});
