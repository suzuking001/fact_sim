codex
I found a concrete defect in the mode fallback layer: when these fast-host files are loaded without the legacy mode helpers already present, `event-fast` gets normalized down to `dt`. That strips `event-fast` out of supported/benchmark/test mode lists in isolated loads, so I’m patching the fallback normalizers only.
file update
M C:\Users\suzuk\AppData\Local\Temp\fact-sim-auto-patch\1773523644778-15448\js\app\engine-fast-worker-host.js
@@ -54,2 +54,10 @@
 
+  function normalizeLegacyBaseMode(mode){
+    const raw = String(mode || '').trim().toLowerCase();
+    if(raw === 'event-fast' || raw === 'event_fast' || raw === 'eventfast'){
+      return 'event-fast';
+    }
+    return raw === 'event' ? 'event' : 'dt';
+  }
+
   function serializeGraphForWorker(graphOrData){
@@ -860,3 +868,3 @@
     ? App.normalizeSimMode.bind(App)
-    : function(mode){ return String(mode || '').trim().toLowerCase() === 'event' ? 'event' : 'dt'; };
+    : normalizeLegacyBaseMode;
   const legacyGetSimModeLabel = (typeof App.getSimModeLabel === 'function')
