"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
const fs = require('fs');
const vm = require('vm');
const ctx = {
  console,
  performance: { now: () => 0 },
  Worker: function Worker(){},
  window: { location: { protocol: 'https:' } },
  App: {
    getSupportedSimModes(){ return ['dt','event','event-fast']; },
    normalizeSimMode(mode){ return String(mode || '').trim().toLowerCase() === 'event' ? 'event' : 'dt'; },
    getSimModeLabel(mode){ return String(mode || ''); },
    createSimEngine(mode){ return { mode, runtimeMode: mode, reset(){}, getDebugStats(){ return { runtimeMode: mode }; } }; },
    normalizeHeadlessSimMode(mode){ return String(mode || '').trim().toLowerCase(); },
    getHeadlessModeLabel(mode){ return String(mode || ''); },
    isHeadlessOnlyBenchmarkMode(){ return false; },
    getBenchmarkSimModes(){ return ['dt','event-fast']; },
    getEngineTestModes(){ return ['dt','event-fast']; },
    createHeadlessSimRunner(mode){ return { mode, asyncOnly: true, runtimeMode: 'stub-headless' }; }
  }
};
ctx.window.App = ctx.App;
vm.createContext(ctx);
for (const file of ['js/app/engine-fast-par-host.js', 'js/app/engine-fast-worker-host.js']) {
  vm.runInContext(fs.readFileSync(file, 'utf8'), ctx, { filename: file });
}
const out = {
  normalizeHeadless: ctx.App.normalizeHeadlessSimMode('event-fast-par'),
  isHeadlessOnly: ctx.App.isHeadlessOnlyBenchmarkMode('event-fast-par'),
  benchmarkModes: ctx.App.getBenchmarkSimModes(),
  engineTestModes: ctx.App.getEngineTestModes()
};
console.log(JSON.stringify(out, null, 2));
