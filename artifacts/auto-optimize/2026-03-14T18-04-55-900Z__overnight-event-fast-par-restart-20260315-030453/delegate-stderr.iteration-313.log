const fs = require('fs');
const vm = require('vm');

const source = fs.readFileSync('js/app/engine-fast-par-host.js', 'utf8');
const workerInstances = [];
class FakeWorker {
  constructor(url){
    this.url = url;
    this.listeners = { message: [], error: [] };
    this.messages = [];
    workerInstances.push(this);
  }
  addEventListener(type, fn){
    (this.listeners[type] || (this.listeners[type] = [])).push(fn);
  }
  postMessage(msg){
    this.messages.push(msg);
    const payload = msg.type === 'init'
      ? { runtimeMode: 'parallel', stats: {} }
      : msg.type === 'stop'
        ? { stopped: true }
        : { stats: {} };
    queueMicrotask(() => {
      for(const fn of this.listeners.message || []) fn({ data: { id: msg.id, ok: true, payload } });
    });
  }
  terminate(){ this.terminated = true; }
}

const context = {
  window: { location: { protocol: 'https:' } },
  Worker: FakeWorker,
  LGraph: function(){},
  LiteGraph: { getTime(){ return 0; }, STATUS_RUNNING: 1, STATUS_STOPPED: 2 },
  configureGraphClock(){},
  performance: { now(){ return 0; } },
  console,
  setTimeout,
  clearTimeout,
  Promise,
  Math,
  JSON,
};
context.window.App = {
  createHeadlessSimRunner(){ throw new Error('unexpected fallback'); }
};
context.App = context.window.App;
vm.createContext(context);
vm.runInContext(source, context);

(async () => {
  const host = new context.window.App.EventFastParHost({ nodes: [], links: [] }, {
    __precomputedPlan: {
      canParallelize: true,
      cutEdgeCount: 1,
      graphData: { nodes: [], links: [] },
      partitions: [
        { partitionId: 0, nodeIds: [1], outgoingCutEdges: [] },
        { partitionId: 1, nodeIds: [2], outgoingCutEdges: [] }
      ]
    }
  });
  await host.resetAsync();
  await host.disposeAsync();
  console.log(JSON.stringify(workerInstances.map((w) => w.messages.map((m) => m.type))));
})().catch((err) => {
  console.error(err);
  process.exit(1);
});
