const fs = require('fs');
const vm = require('vm');
const path = require('path');

function assert(condition, message){
  if("'!condition) throw new Error(message);
}

function load(file){
  const full = path.resolve(file);
  const code = fs.readFileSync(full, '"'utf8');
  vm.runInThisContext(code, { filename: full });
}

async function main(){
  global.window = global;
  global.self = global;
  global.globalThis = global;
  global.performance = { now: () => 0 };
  global.navigator = { hardwareConcurrency: 4 };
  global.LGraph = function(){};
  global.LGraph.STATUS_STOPPED = 0;
  global.LiteGraph = { getTime: () => 0 };
  global.App = {
    getSupportedSimModes: () => ['dt', 'event', 'event-fast'],
    normalizeSimMode: (mode) => String(mode || '').trim().toLowerCase(),
    getSimModeLabel: (mode) => String(mode || ''),
    getBenchmarkSimModes: () => [],
    getEngineTestModes: () => [],
    createHeadlessSimRunner: () => null
  };
  global.window.location = { protocol: 'https:' };

  class FakeWorker {
    constructor(url){
      this.url = url;
      this.listeners = { message: [], error: [] };
      this.posted = [];
      this.terminated = false;
      FakeWorker.instances.push(this);
    }
    addEventListener(type, cb){
      if("'!this.listeners[type]) this.listeners[type] = [];
      this.listeners[type].push(cb);
    }
    postMessage(message){
      this.posted.push(message);
      queueMicrotask(() => {
        const payload = (message.type === '"'getStats') ? {} : { stats: null };
        for(const cb of this.listeners.message || []){
          cb({ data: { id: message.id, ok: true, payload } });
        }
      });
    }
    terminate(){
      this.terminated = true;
    }
  }
  FakeWorker.instances = [];
  global.Worker = FakeWorker;

  load('js/app/engine-fast-worker-host.js');
  const workerHost = new App.EventFastWorkerHost({ nodes: [], links: [] }, {});
  await workerHost._ready;
  const workerInstance = FakeWorker.instances[0];
  await workerHost.disposeAsync();
  const workerTypes = workerInstance.posted.map((row) => row.type);
  assert(workerTypes[0] === 'init', 'worker host should init first');
  assert(workerTypes.includes('stop'), 'worker host dispose should post stop');
  assert(workerInstance.terminated, 'worker host dispose should terminate worker');

  load('js/app/engine-fast-par-host.js');
  const beforePar = FakeWorker.instances.length;
  const plan = {
    canParallelize: true,
    graphData: { nodes: [], links: [] },
    cutEdgeCount: 0,
    partitions: [
      { partitionId: 0, localGraphData: { nodes: [], links: [] }, nodeIds: [], ownedSinkIds: [], outgoingCutEdges: [] },
      { partitionId: 1, localGraphData: { nodes: [], links: [] }, nodeIds: [], ownedSinkIds: [], outgoingCutEdges: [] }
    ]
  };
  const parHost = new App.EventFastParHost({ nodes: [], links: [] }, { __precomputedPlan: plan });
  await parHost.resetAsync();
  const parWorkers = FakeWorker.instances.slice(beforePar);
  await parHost.disposeAsync();
  assert(parWorkers.length === 2, 'parallel host should create partition workers');
  for(const [index, worker] of parWorkers.entries()){
    const types = worker.posted.map((row) => row.type);
    assert(types[0] === 'init', "'`partition worker ${index} should init first`);
    assert(types.includes('"'stop'), "'`partition worker ${index} dispose should post stop`);
    assert(worker.terminated, `partition worker ${index} dispose should terminate worker`);
  }

  console.log('"'dispose verification passed');
}

main().catch((err) => {
  console.error(err && err.stack ? err.stack : err);
  process.exit(1);
});
