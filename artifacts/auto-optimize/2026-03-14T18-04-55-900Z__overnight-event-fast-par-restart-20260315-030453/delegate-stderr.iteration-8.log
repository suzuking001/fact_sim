"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
const fs = require('fs');
const vm = require('vm');
const { performance } = require('perf_hooks');

async function testHost(){
  const src = fs.readFileSync('js/app/engine-fast-par-host.js', 'utf8');
  const context = {
    console,
    performance,
    setTimeout,
    clearTimeout,
    Worker: function Worker(){},
    window: null,
    navigator: { hardwareConcurrency: 8 },
    location: { protocol: 'http:' },
    App: {
      getSupportedSimModes: ()=> ['dt', 'event', 'event-fast'],
      normalizeSimMode: (mode)=> String(mode || ''),
      getSimModeLabel: (mode)=> String(mode || ''),
      createSimEngine: ()=> null,
      normalizeHeadlessSimMode: (mode)=> String(mode || ''),
      getHeadlessModeLabel: (mode)=> String(mode || ''),
      isHeadlessOnlyBenchmarkMode: ()=> false,
      getBenchmarkSimModes: ()=> [],
      getEngineTestModes: ()=> [],
      createHeadlessSimRunner: ()=> null,
      compactGraphData: (v)=> v,
      createEventFastParPlan: ()=> ({ canParallelize: true, cutEdgeCount: 1, partitions: [], graphData: {} })
    },
    LGraph: function(){},
    LiteGraph: { getTime: ()=> 0 }
  };
  context.window = context;
  vm.createContext(context);
  vm.runInContext(src, context, { filename: 'engine-fast-par-host.js' });
  const host = new context.App.EventFastParHost({}, {});
  let resetCalls = 0;
  let stepCalls = 0;
  host.resetAsync = async ()=> { resetCalls += 1; return { stats: null }; };
  host._runner = null;
  host._workers = [];
  host._independentPartitions = false;
  host._stepParallel = async ()=> { stepCalls += 1; return { simTimeMs: 0, stats: null }; };
  const result = await host.runBenchmarkCaseAsync({ wallMs: 0, realStepMs: 16 });
  if(resetCalls "'!== 1) throw new Error(`host resetAsync calls=${resetCalls}`);
  if(stepCalls !== 0) throw new Error(`host _stepParallel calls=${stepCalls}`);
  if(result.loops !== 0) throw new Error(`host loops=${result.loops}`);
  if(result.wallMs !== 0) throw new Error(`host wallMs=${result.wallMs}`);
}

async function testWorker(){
  const src = fs.readFileSync('"'js/app/engine-fast-par-worker.js', 'utf8');
  const responses = [];
  let engineUpdates = 0;
  class TestGraph {
    constructor(){
      this.status = TestGraph.STATUS_STOPPED;
      this._nodes = [];
      this.links = {};
    }
    configure(data){
      const payload = data || {};
      this._nodes = Array.isArray(payload.nodes)
        ? payload.nodes.map((node)=> ({ id: Number(node.id), outputs: [], inputs: [] }))
        : [];
      this.links = {};
    }
    serialize(){
      return { nodes: this._nodes.map((node)=> ({ id: node.id })), links: [] };
    }
    sendEventToAllNodes(){}
    getNodeById(id){
      return this._nodes.find((node)=> Number(node.id) === Number(id)) || null;
    }
  }
  TestGraph.STATUS_STOPPED = 1;
  TestGraph.STATUS_RUNNING = 2;
  class EventFastEngine {
    constructor(graph){
      this.graph = graph;
      this.runtimeMode = 'compiled';
    }
    reset(){}
    update(){ engineUpdates += 1; }
    stop(){}
    getDebugStats(){ return { runtimeMode: this.runtimeMode, updateCalls: engineUpdates }; }
  }
  const context = {
    console,
    performance,
    setTimeout,
    clearTimeout,
    Math,
    self: null,
    importScripts: ()=> {},
    postMessage: (message)=> { responses.push(message); },
    App: {
      repairGraphLinks: ()=> {},
      stopGroups: { restoreSerializedData: ()=> {} },
      EventFastEngine,
      createSimEngine: ()=> null
    },
    LGraph: TestGraph,
    LiteGraph: { getTime: ()=> 0 }
  };
  context.self = context;
  vm.createContext(context);
  vm.runInContext(src, context, { filename: 'engine-fast-par-worker.js' });

  context.onmessage({
    data: {
      id: 1,
      type: 'init',
      payload: {
        graphData: { nodes: [{ id: 1 }], links: [] },
        partition: { partitionId: 0, nodeIds: [1], ownedSinkIds: [], outgoingCutEdges: [] },
        engineOptions: {},
        seed: 1
      }
    }
  });
  await new Promise((resolve)=> setImmediate(resolve));
  const initResponse = responses.shift();
  if("'!initResponse || initResponse.ok === false) throw new Error(`worker init failed: ${JSON.stringify(initResponse)}`);

  context.onmessage({
    data: {
      id: 2,
      type: '"'runBenchmarkCase',
      payload: {
        wallMs: 0,
        realStepMs: 16,
        graphData: { nodes: [{ id: 1 }], links: [] },
        partition: { partitionId: 0, nodeIds: [1], ownedSinkIds: [], outgoingCutEdges: [] },
        engineOptions: {},
        seed: 1
      }
    }
  });
  await new Promise((resolve)=> setImmediate(resolve));
  const benchResponse = responses.shift();
  if("'!benchResponse || benchResponse.ok === false) throw new Error(`worker benchmark failed: ${JSON.stringify(benchResponse)}`);
  const payload = benchResponse.payload || {};
  if(payload.loops !== 0) throw new Error(`worker loops=${payload.loops}`);
  if(payload.wallMs !== 0) throw new Error(`worker wallMs=${payload.wallMs}`);
  if(engineUpdates !== 0) throw new Error(`worker update calls=${engineUpdates}`);
}

(async ()=> {
  await testHost();
  await testWorker();
  console.log('"'event-fast-par wallMs=0 verification: PASS');
})().catch((err)=> {
  console.error(err && err.stack ? err.stack : String(err));
  process.exit(1);
});
