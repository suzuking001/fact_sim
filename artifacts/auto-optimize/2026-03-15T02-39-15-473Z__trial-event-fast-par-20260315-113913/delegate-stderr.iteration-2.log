実エンジンの 500ms benchmark は exposed MCP API から `event-fast-par` を選べなかったので、今回変えた hot path を局所ベンチします。これはエンジン全体速度の代替ではなく、`flatMap`/bucket 生成の削減が実測で有利かを確認するためです。
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
const { performance } = require('perf_hooks');

function oldBucketMessages(messages, partitionCount){
  const buckets = new Array(Math.max(0, partitionCount));
  for(let i = 0; i < buckets.length; i += 1) buckets[i] = [];
  for(const message of Array.isArray(messages) ? messages : []){
    if("'!message) continue;
    const target = Number(message.toPartitionId);
    if(target < 0 || target >= buckets.length) continue;
    buckets[target].push(message);
  }
  return buckets;
}

function newBucketMessagesFromResults(rows, partitionCount){
  const size = Math.max(0, partitionCount);
  const buckets = new Array(size);
  const touchedFlags = new Uint8Array(size);
  let touchedCount = 0;
  for(const row of Array.isArray(rows) ? rows : []){
    const messages = Array.isArray(row && row.emittedMessages) ? row.emittedMessages : [];
    for(const message of messages){
      if(!message) continue;
      const target = Number(message.toPartitionId);
      if(target < 0 || target >= size) continue;
      if(!buckets[target]){
        buckets[target] = [];
        touchedFlags[target] = 1;
        touchedCount += 1;
      }
      buckets[target].push(message);
    }
  }
  const touched = new Array(touchedCount);
  let writeIndex = 0;
  for(let i = 0; i < size; i += 1){
    if(!touchedFlags[i]) continue;
    touched[writeIndex] = i;
    writeIndex += 1;
  }
  return { buckets, touched };
}

function makeResults(partitionCount, messagesPerPartition){
  const rows = new Array(partitionCount);
  for(let p = 0; p < partitionCount; p += 1){
    const emittedMessages = new Array(messagesPerPartition);
    for(let i = 0; i < messagesPerPartition; i += 1){
      emittedMessages[i] = {
        toPartitionId: (p + i + 1) % partitionCount,
        value: i,
        linkId: p * 100 + i
      };
    }
    rows[p] = { emittedMessages };
  }
  return rows;
}

function bench(label, fn, iterations){
  for(let i = 0; i < 5000; i += 1) fn();
  const started = performance.now();
  let checksum = 0;
  for(let i = 0; i < iterations; i += 1){
    const out = fn();
    checksum += Array.isArray(out) ? out.length : out.touched.length;
  }
  const elapsed = performance.now() - started;
  return { label, elapsed, checksum };
}

const partitionCount = 8;
const messagesPerPartition = 6;
const iterations = 200000;
const results = makeResults(partitionCount, messagesPerPartition);
const oldRes = bench('"'old', () => oldBucketMessages(results.flatMap((row) => Array.isArray(row && row.emittedMessages) ? row.emittedMessages : []), partitionCount), iterations);
const newRes = bench('new', () => newBucketMessagesFromResults(results, partitionCount), iterations);
const improvementPct = ((oldRes.elapsed - newRes.elapsed) / oldRes.elapsed) * 100;
console.log(JSON.stringify({ partitionCount, messagesPerPartition, iterations, oldMs: Number(oldRes.elapsed.toFixed(2)), newMs: Number(newRes.elapsed.toFixed(2)), improvementPct: Number(improvementPct.toFixed(2)) }));
