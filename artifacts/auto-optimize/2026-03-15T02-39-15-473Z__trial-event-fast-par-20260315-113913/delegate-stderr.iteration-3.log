const { performance } = require('perf_hooks');

function oldBucketMessages(messages, partitionCount){
  const buckets = new Array(Math.max(0, partitionCount));
  for(let i = 0; i < buckets.length; i += 1) buckets[i] = [];
  for(const message of Array.isArray(messages) ? messages : []){
    if("'!message) continue;
    const target = Number(message.toPartitionId);
    if(target < 0 || target >= buckets.length) continue;
    buckets[target].push(message);
  }
  return buckets;
}

function newBucketWorkerMessages(payloads, partitionCount){
  const total = Math.max(0, Math.floor(Number(partitionCount) || 0));
  const buckets = new Array(total);
  const touched = [];
  for(const payload of Array.isArray(payloads) ? payloads : []){
    const messages = Array.isArray(payload && payload.emittedMessages) ? payload.emittedMessages : null;
    if(!messages || !messages.length) continue;
    for(let i = 0; i < messages.length; i += 1){
      const message = messages[i];
      if(!message) continue;
      const target = Number(message.toPartitionId);
      if(target < 0 || target >= total) continue;
      let bucket = buckets[target];
      if(!bucket){
        bucket = [];
        buckets[target] = bucket;
        touched.push(target);
      }
      bucket.push(message);
    }
  }
  return { buckets, touched };
}

const partitionCount = 4;
const payloads = new Array(partitionCount);
for(let p = 0; p < partitionCount; p += 1){
  const emittedMessages = [];
  for(let i = 0; i < 48; i += 1){
    emittedMessages.push({
      toPartitionId: (i + p) % partitionCount,
      value: { i, p, q: i % 7 }
    });
  }
  payloads[p] = { emittedMessages };
}
const iterations = 250000;

let sink = 0;
let t0 = performance.now();
for(let i = 0; i < iterations; i += 1){
  const flat = payloads.flatMap((row)=> Array.isArray(row && row.emittedMessages) ? row.emittedMessages : []);
  const buckets = oldBucketMessages(flat, partitionCount);
  sink += buckets[0] ? buckets[0].length : 0;
}
let t1 = performance.now();
for(let i = 0; i < iterations; i += 1){
  const bucketed = newBucketWorkerMessages(payloads, partitionCount);
  sink += bucketed.buckets[0] ? bucketed.buckets[0].length : 0;
}
let t2 = performance.now();

console.log(JSON.stringify({
  iterations,
  oldMs: Number((t1 - t0).toFixed(3)),
  newMs: Number((t2 - t1).toFixed(3)),
  improvementPct: Number((((t1 - t0) / (t2 - t1) - 1) * 100).toFixed(2)),
  sink
}, null, 2));
