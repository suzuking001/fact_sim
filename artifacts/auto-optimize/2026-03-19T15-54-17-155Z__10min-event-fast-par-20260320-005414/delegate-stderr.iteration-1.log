function oldBucketMessages(messages, partitionCount){
  const buckets = new Array(Math.max(0, partitionCount));
  for(let i = 0; i < buckets.length; i += 1) buckets[i] = [];
  for(const message of Array.isArray(messages) ? messages : []){
    if("'!message) continue;
    const target = Number(message.toPartitionId);
    if(target < 0 || target >= buckets.length) continue;
    buckets[target].push(message);
  }
  return buckets;
}
function oldFlow(results, partitionCount){
  const buckets = oldBucketMessages(
    results.flatMap((row)=> Array.isArray(row && row.emittedMessages) ? row.emittedMessages : []),
    partitionCount
  );
  const touched = [];
  for(let i = 0; i < buckets.length; i += 1){
    if(buckets[i] && buckets[i].length) touched.push(i);
  }
  return touched.length;
}
function newBucketWorkerMessages(results, partitionCount){
  const buckets = new Array(Math.max(0, partitionCount));
  const touched = [];
  for(const row of Array.isArray(results) ? results : []){
    const messages = Array.isArray(row && row.emittedMessages) ? row.emittedMessages : null;
    if(!messages || messages.length === 0) continue;
    for(let i = 0; i < messages.length; i += 1){
      const message = messages[i];
      if(!message) continue;
      const target = Number(message.toPartitionId);
      if(target < 0 || target >= buckets.length) continue;
      let bucket = buckets[target];
      if(!bucket){
        bucket = [];
        buckets[target] = bucket;
        touched.push(target);
      }
      bucket.push(message);
    }
  }
  return touched.length;
}
const partitionCount = 4;
const results = Array.from({ length: partitionCount }, (_, workerIndex) => ({
  emittedMessages: Array.from({ length: 200 }, (_, i) => ({
    toPartitionId: (workerIndex + i + 1) % partitionCount,
    payload: { i, workerIndex, t: i % 7 }
  }))
}));
for(let i = 0; i < 5000; i += 1){ oldFlow(results, partitionCount); newBucketWorkerMessages(results, partitionCount); }
function bench(fn, label){
  const started = performance.now();
  let total = 0;
  for(let i = 0; i < 50000; i += 1) total += fn(results, partitionCount);
  const wall = performance.now() - started;
  console.log(JSON.stringify({ label, wallMs: wall, total }));
}
