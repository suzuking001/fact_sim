r\n  <div id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\r\n  <!-- Timing Chart Dock -->\r\n  <div id=\"timelineDock\" data-view=\"chart\">\r\n    <div id=\"timelineResizeHandle\" aria-label=\"Resize timing chart\"></div>\r\n    <div id=\"timelineHeader\">\r\n      <div class=\"timelineHeaderLeft\">\n        <span class=\"timelineTitle\">Workspace</span>\n        <div class=\"timelineTabs\" role=\"tablist\" aria-label=\"Timeline dock tabs\">\n          <button id=\"timelineTabChart\" class=\"timelineTab is-active\" role=\"tab\" aria-selected=\"true\">Timeline</button>\n          <button id=\"timelineTabProps\" class=\"timelineTab\" role=\"tab\" aria-selected=\"false\">Table</button>\n          <button id=\"timelineTabInspector\" class=\"timelineTab\" role=\"tab\" aria-selected=\"false\">Inspector</button>\n        </div>\n      </div>\n      <span id=\"timelineSelection\" class=\"timelineSelection\">Selection: -</span>\n      <span id=\"timelinePropsMeta\" class=\"timelinePropsMeta\" aria-live=\"polite\"></span>\n      <div id=\"timelineChartActions\" class=\"timelineActions\">\n        <button id=\"timelineAutoOrderBtn\" class=\"timelineBtn\">Reset Order</button>\n        <button id=\"timelineExportBtn\" class=\"timelineBtn\">Export CSV</button>\n        <button id=\"timelineFollowBtn\" class=\"timelineBtn\">Auto Follow: ON</button>\n      </div>\n      <div id=\"timelinePropsActions\" class=\"timelineActions\">\n        <button id=\"nodePropsRefreshBtn\" class=\"timelineBtn\">Refresh</button>\n      </div>\n      <div id=\"timelineInspectorActions\" class=\"timelineActions\">\n        <button id=\"selectionInspectorRefreshBtn\" class=\"timelineBtn\">Refresh</button>\n        <button id=\"selectionInspectorClearBtn\" class=\"timelineBtn\">Clear</button>\n      </div>\n    </div>\n    <div id=\"timelineBody\" class=\"view-chart\">\n      <canvas id=\"timelineCanvas\"></canvas>\n      <div id=\"nodePropsPanel\" aria-label=\"Node browser\">\n        <div class=\"nodePropsToolbar\">\r\n          <input id=\"nodePropsFilter\" type=\"text\" placeholder=\"Search node, type, connection, or property...\" aria-label=\"Filter nodes\" />\n          <span id=\"nodePropsSummary\">0 rows</span>\n        </div>\n        <div class=\"nodePropsTableWrap\">\n          <table id=\"nodePropsTable\" aria-label=\"Node list\">\n            <thead>\n              <tr>\n                <th>ID</th>\n                <th>Node</th>\n                <th>Type</th>\n                <th>Connected To</th>\n                <th>Property Summary</th>\n              </tr>\n            </thead>\n            <tbody id=\"nodePropsBody\"></tbody>\n          </table>\n        </div>\n      </div>\n      <div id=\"selectionInspectorPanel\" aria-label=\"Selection inspector\"></div>\n    </div>\n  </div>\n  <div id=\"timelineRevealHandle\" aria-label=\"Drag up to show bottom panel\"></div>\n  <!-- Script Editor Modal -->\n  <div id=\"scriptEditorModal\">\n    <div id=\"scriptEditorContainer\">\r\n      <textarea id=\"scriptEditorTextarea\"></textarea>\r\n      <div id=\"scriptEditorControls\">\r\n        <button id=\"scriptEditorSave\">Save</button>\r\n        <button id=\"scriptEditorCancel\">Cancel</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Benchmark Result Modal -->\r\n  <div id=\"benchmarkModal\" aria-hidden=\"true\" role=\"dialog\">\n    <div id=\"benchmarkContainer\" role=\"document\" aria-label=\"Engine benchmark results\">\n      <div class=\"benchmarkHeader\">\r\n        <h2>Engine Benchmark</h2>\r\n        <button id=\"benchmarkClose\" aria-label=\"Close\">Close</button>\r\n      </div>\r\n      <div id=\"benchmarkProgressWrap\" class=\"benchmarkProgressWrap\" aria-live=\"polite\">\r\n        <div id=\"benchmarkProgressLabel\" class=\"benchmarkProgressLabel\">Benchmark running...</div>\r\n        <div class=\"benchmarkProgressTrack\">\r\n          <div id=\"benchmarkProgressBar\" class=\"benchmarkProgressBar\"></div>\r\n        </div>\r\n      </div>\r\n      <p id=\"benchmarkSummary\" class=\"benchmarkSummary\"></p>\r\n      <p id=\"benchmarkLegend\" class=\"benchmarkLegend\">\n        `speed` is the ratio of simulated time progressed per real time (higher is faster).<br>\n        `Case` indicates whether rendering is off or uses the current Render FPS limit.<br>\n        Bars are shown relative to the fastest result as 100%.\n      </p>\n      <table id=\"benchmarkTable\" aria-label=\"Benchmark result table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Engine</th>\r\n            <th>Case</th>\r\n            <th>Speed</th>\r\n            <th>Sim Time</th>\r\n            <th>Wall Time</th>\r\n            <th>Loops</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody id=\"benchmarkBody\"></tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Share URL Modal -->\n  <div id=\"shareUrlModal\" aria-hidden=\"true\" role=\"dialog\">\n    <div id=\"shareUrlContainer\" role=\"document\" aria-label=\"Share URL details\">\n      <div class=\"shareUrlHeader\">\r\n        <h2>Share URL</h2>\r\n        <button id=\"shareUrlClose\" aria-label=\"Close\">Close</button>\r\n      </div>\r\n      <div class=\"shareUrlBody\">\r\n        <p>\r\n          Share URL compresses graph JSON and embeds it in the URL hash (<code>#g=...</code>).\r\n        </p>\r\n        <p>\r\n          Graph data is not sent to external servers. Shared data stays in this URL string.\r\n        </p>\r\n        <p>\r\n          URL length limits vary by browser/environment, so very large graphs may not open via URL.\r\n        </p>\r\n        <label for=\"shareUrlValue\">Generated URL</label>\r\n        <textarea id=\"shareUrlValue\" readonly aria-label=\"Generated share URL\"></textarea>\r\n        <div class=\"shareUrlMeta\">\r\n          <span id=\"shareUrlLength\">Length: 0</span>\r\n          <span id=\"shareUrlWarning\"></span>\r\n        </div>\r\n        <div class=\"shareUrlActions\">\r\n          <button id=\"shareUrlCopyBtn\">Copy Again</button>\r\n        </div>\r\n      </div>\r\n    </div>\n  </div>\n\n  <!-- Engine Test Modal -->\n  <div id=\"engineTestModal\" aria-hidden=\"true\" role=\"dialog\">\n    <div id=\"engineTestContainer\" role=\"document\" aria-label=\"Engine test results\">\n      <div class=\"benchmarkHeader\">\n        <h2>Engine Test</h2>\n        <button id=\"engineTestClose\" aria-label=\"Close\">Close</button>\n      </div>\n      <div id=\"engineTestProgressWrap\" class=\"benchmarkProgressWrap\" aria-live=\"polite\">\n        <div id=\"engineTestProgressLabel\" class=\"benchmarkProgressLabel\">Engine test running...</div>\n        <div class=\"benchmarkProgressTrack\">\n          <div id=\"engineTestProgressBar\" class=\"benchmarkProgressBar\"></div>\n        </div>\n      </div>\n      <div id=\"engineTestToolbar\" class=\"engineTestToolbar\">\n        <p id=\"engineTestSummary\" class=\"benchmarkSummary\"></p>\n        <div class=\"engineTestToolbarActions\">\n          <button id=\"engineTestRerunBtn\">Run Again</button>\n          <button id=\"engineTestCopyBtn\">Copy Report JSON</button>\n        </div>\n      </div>\n      <p id=\"engineTestLegend\" class=\"benchmarkLegend\">\n        Engine Test runs clone graphs only. It checks monotonic simulation time, graph integrity, finite numeric state, sink completion metrics, and engine stalls without touching the live canvas graph.\n      </p>\n      <div class=\"engineTestSection\">\n        <h3>Cases</h3>\n        <table id=\"engineTestCasesTable\" aria-label=\"Engine test case table\">\n          <thead>\n            <tr>\n              <th>Status</th>\n              <th>Engine</th>\n              <th>Scenario</th>\n              <th>Sim Time</th>\n              <th>Completed</th>\n              <th>Notes</th>\n            </tr>\n          </thead>\n          <tbody id=\"engineTestCasesBody\"></tbody>\n        </table>\n      </div>\n      <div class=\"engineTestSection\">\n  