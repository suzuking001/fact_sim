ss=\"nodePropsToolbar\">\r\n          <input id=\"nodePropsFilter\" type=\"text\" placeholder=\"Search node, type, connection, or property...\" aria-label=\"Filter nodes\" />\n          <span id=\"nodePropsSummary\">0 rows</span>\n        </div>\n        <div class=\"nodePropsTableWrap\">\n          <table id=\"nodePropsTable\" aria-label=\"Node list\">\n            <thead>\n              <tr>\n                <th>ID</th>\n                <th>Node</th>\n                <th>Type</th>\n                <th>Connected To</th>\n                <th>Property Summary</th>\n              </tr>\n            </thead>\n            <tbody id=\"nodePropsBody\"></tbody>\n          </table>\n        </div>\n      </div>\n      <div id=\"selectionInspectorPanel\" aria-label=\"Selection inspector\"></div>\n    </div>\n  </div>\n  <div id=\"timelineRevealHandle\" aria-label=\"Drag up to show bottom panel\"></div>\n  <!-- Script Editor Modal -->\n  <div id=\"scriptEditorModal\">\n    <div id=\"scriptEditorContainer\">\r\n      <textarea id=\"scriptEditorTextarea\"></textarea>\r\n      <div id=\"scriptEditorControls\">\r\n        <button id=\"scriptEditorSave\">Save</button>\r\n        <button id=\"scriptEditorCancel\">Cancel</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Benchmark Result Modal -->\r\n  <div id=\"benchmarkModal\" aria-hidden=\"true\" role=\"dialog\">\n    <div id=\"benchmarkContainer\" role=\"document\" aria-label=\"Engine benchmark results\">\n      <div class=\"benchmarkHeader\">\r\n        <h2>Engine Benchmark</h2>\r\n        <button id=\"benchmarkClose\" aria-label=\"Close\">Close</button>\r\n      </div>\r\n      <div id=\"benchmarkProgressWrap\" class=\"benchmarkProgressWrap\" aria-live=\"polite\">\r\n        <div id=\"benchmarkProgressLabel\" class=\"benchmarkProgressLabel\">Benchmark running...</div>\r\n        <div class=\"benchmarkProgressTrack\">\r\n          <div id=\"benchmarkProgressBar\" class=\"benchmarkProgressBar\"></div>\r\n        </div>\r\n      </div>\r\n      <p id=\"benchmarkSummary\" class=\"benchmarkSummary\"></p>\r\n      <p id=\"benchmarkLegend\" class=\"benchmarkLegend\">\n        `speed` is the ratio of simulated time progressed per real time (higher is faster).<br>\n        `Case` indicates whether rendering is off or uses the current Render FPS limit.<br>\n        Bars are shown relative to the fastest result as 100%.\n      </p>\n      <table id=\"benchmarkTable\" aria-label=\"Benchmark result table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Engine</th>\r\n            <th>Case</th>\r\n            <th>Speed</th>\r\n            <th>Sim Time</th>\r\n            <th>Wall Time</th>\r\n            <th>Loops</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody id=\"benchmarkBody\"></tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Share URL Modal -->\n  <div id=\"shareUrlModal\" aria-hidden=\"true\" role=\"dialog\">\n    <div id=\"shareUrlContainer\" role=\"document\" aria-label=\"Share URL details\">\n      <div class=\"shareUrlHeader\">\r\n        <h2>Share URL</h2>\r\n        <button id=\"shareUrlClose\" aria-label=\"Close\">Close</button>\r\n      </div>\r\n      <div class=\"shareUrlBody\">\r\n        <p>\r\n          Share URL compresses graph JSON and embeds it in the URL hash (<code>#g=...</code>).\r\n        </p>\r\n        <p>\r\n          Graph data is not sent to external servers. Shared data stays in this URL string.\r\n        </p>\r\n        <p>\r\n          URL length limits vary by browser/environment, so very large graphs may not open via URL.\r\n        </p>\r\n        <label for=\"shareUrlValue\">Generated URL</label>\r\n        <textarea id=\"shareUrlValue\" readonly aria-label=\"Generated share URL\"></textarea>\r\n        <div class=\"shareUrlMeta\">\r\n          <span id=\"shareUrlLength\">Length: 0</span>\r\n          <span id=\"shareUrlWarning\"></span>\r\n        </div>\r\n        <div class=\"shareUrlActions\">\r\n      