{
  "version": 1,
  "kind": "engine-optimize",
  "name": "event-fast optimize",
  "key": "event-fast-optimize",
  "goal": "Maximize event-fast speed while preserving dt parity.",
  "target": {
    "engine": "event-fast",
    "protectedEngines": [
      "dt",
      "event"
    ]
  },
  "delegate": {
    "type": "auto-patch-event-fast",
    "command": "node scripts/auto-patch-event-fast.mjs"
  },
  "defaults": {
    "profile": "nightly",
    "engines": [
      "dt",
      "event",
      "event-fast"
    ],
    "optimizeEngines": [
      "event-fast"
    ],
    "examples": null,
    "seeds": [
      1
    ],
    "includeCurrentGraph": false,
    "strict": true,
    "reruns": 1,
    "stopOnFirstFailure": true
  },
  "runtime": {
    "benchmarkExample": "parallel_benchmark",
    "benchmarkWallMs": 2000,
    "delegateTimeoutMs": 480000,
    "promptMode": "compact",
    "scopeMode": "focused",
    "minImprovementPct": 1,
    "maxIterations": 6,
    "minRuntimeHours": 0,
    "maxNoImprovementIterations": 3
  },
  "statusFile": "artifacts/auto-optimize/latest-event-fast-status.json"
}
