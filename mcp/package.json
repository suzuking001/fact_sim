{
  "name": "fact_sim_mcp",
  "version": "0.3.0",
  "description": "Integrated AI-first MCP server for controlling fact_sim via Playwright",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "auto-fix-runner": "node scripts/auto-fix-runner.mjs",
    "auto-patch-event-fast": "node scripts/auto-patch-event-fast.mjs",
    "auto-optimize-event-fast": "node scripts/auto-optimize-event-fast.mjs",
    "watch:auto-optimize": "node scripts/watch-auto-optimize-status.mjs",
    "nightly": "node scripts/auto-fix-runner.mjs --profile nightly",
    "nightly:auto-patch": "node scripts/auto-fix-runner.mjs --profile nightly --patch-command \"node scripts/auto-patch-event-fast.mjs\"",
    "nightly:optimize": "node scripts/auto-optimize-event-fast.mjs --profile nightly"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzuking001/fact_sim.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN ../LICENSE",
  "bugs": {
    "url": "https://github.com/suzuking001/fact_sim/issues"
  },
  "homepage": "https://github.com/suzuking001/fact_sim#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "typescript": "^5.9.3"
  }
}
